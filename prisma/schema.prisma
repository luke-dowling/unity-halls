generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DM
  PLAYER
}

enum PlayerClass {
  CLERIC
  RANGER
  BLOOD_HUNTER
  PALADIN
  SORCERER
}

enum FolderType {
  SOUNDTRACK
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String
  passwordHash  String
  role          Role         @default(PLAYER)
  characterName String?
  playerClass   PlayerClass?
  seatIndex     Int?         @unique
  portraitId    String?
  portraitUrl   String?
  shadowColor   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Folder {
  id          String       @id @default(cuid())
  name        String
  type        FolderType
  parentId    String?
  parent      Folder?      @relation("FolderChildren", fields: [parentId], references: [id])
  children    Folder[]     @relation("FolderChildren")
  soundtracks Soundtrack[] @relation("SoundtrackFolders")
}

model Track {
  id          String            @id @default(cuid())
  name        String
  url         String
  soundtracks SoundtrackTrack[]
}

model SoundtrackTrack {
  id           String     @id @default(cuid())
  soundtrackId String
  trackId      String
  position     Int
  soundtrack   Soundtrack @relation(fields: [soundtrackId], references: [id], onDelete: Cascade)
  track        Track      @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([soundtrackId, trackId])
}

model Soundtrack {
  id         String            @id @default(cuid())
  name       String
  tracks     SoundtrackTrack[]
  folders    Folder[]          @relation("SoundtrackFolders")
  roomStates RoomState[]
}

model RoomState {
  id              String      @id @default("default")
  backgroundColor String      @default("#0c0a09")
  soundtrackId    String?
  soundtrack      Soundtrack? @relation(fields: [soundtrackId], references: [id])
  isLive          Boolean     @default(false)
  updatedAt       DateTime    @updatedAt
}

model ChatMessage {
  id            String   @id @default(cuid())
  userId        String
  characterName String?
  shadowColor   String?
  content       String
  createdAt     DateTime @default(now())
}
