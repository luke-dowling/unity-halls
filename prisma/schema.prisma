generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlayerClass {
  CLERIC
  RANGER
  BLOOD_HUNTER
  PALADIN
  SORCERER
}

enum FolderType {
  SOUNDTRACK
}

enum MembershipStatus {
  ACTIVE
  LEFT
  PENDING
}

enum PlanTier {
  FREE
  PAID
}

model User {
  id                          String    @id @default(cuid())
  email                       String    @unique
  name                        String
  passwordHash                String?
  emailVerified               DateTime?
  verificationToken           String?   @unique
  verificationTokenExpiresAt  DateTime?
  planTier                    PlanTier  @default(FREE)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  ownedRooms   Room[]           @relation("RoomOwner")
  memberships  RoomMembership[]
  chatMessages ChatMessage[]
}

model Room {
  id                 String      @id @default(cuid())
  name               String
  ownerId            String
  owner              User        @relation("RoomOwner", fields: [ownerId], references: [id])
  // The owner's own DM persona for this room — the owner isn't a
  // RoomMembership row, so their character identity lives here instead.
  ownerCharacterName String?
  ownerPortraitUrl   String?
  ownerShadowColor   String      @default("#f59e0b")
  backgroundColor    String      @default("#0c0a09")
  soundtrackId       String?
  soundtrack         Soundtrack? @relation(fields: [soundtrackId], references: [id])
  isLive             Boolean     @default(false)
  inviteToken        String      @unique @default(cuid())
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  memberships  RoomMembership[]
  chatMessages ChatMessage[]
  sessions     RoomSession[]
}

model RoomSession {
  id        String    @id @default(cuid())
  roomId    String
  room      Room      @relation(fields: [roomId], references: [id])
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([roomId, startedAt])
}

model RoomMembership {
  id            String           @id @default(cuid())
  userId        String
  roomId        String
  status        MembershipStatus @default(ACTIVE)
  seatIndex     Int?
  characterName String?
  playerClass   PlayerClass?
  portraitId    String?
  portraitUrl   String?
  shadowColor   String?
  joinedAt      DateTime         @default(now())
  leftAt        DateTime?
  requestedAt   DateTime?

  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id])

  @@unique([userId, roomId])
  @@unique([roomId, seatIndex])
}

model Folder {
  id          String       @id @default(cuid())
  name        String
  type        FolderType
  parentId    String?
  parent      Folder?      @relation("FolderChildren", fields: [parentId], references: [id])
  children    Folder[]     @relation("FolderChildren")
  soundtracks Soundtrack[] @relation("SoundtrackFolders")
}

model Track {
  id          String            @id @default(cuid())
  name        String
  url         String
  soundtracks SoundtrackTrack[]
}

model SoundtrackTrack {
  id           String     @id @default(cuid())
  soundtrackId String
  trackId      String
  position     Int
  soundtrack   Soundtrack @relation(fields: [soundtrackId], references: [id], onDelete: Cascade)
  track        Track      @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([soundtrackId, trackId])
}

model Soundtrack {
  id      String            @id @default(cuid())
  name    String
  tracks  SoundtrackTrack[]
  folders Folder[]          @relation("SoundtrackFolders")
  rooms   Room[]
}

model ChatMessage {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  roomId        String
  room          Room     @relation(fields: [roomId], references: [id])
  characterName String?
  shadowColor   String?
  content       String
  createdAt     DateTime @default(now())

  @@index([roomId])
}
