# Copy to livekit.env on the VPS and fill in. Never commit livekit.env.

# Domain pointing at this VPS (DNS A record), e.g. livekit.unity-halls.com
LIVEKIT_DOMAIN=

# Generate a key/secret pair, e.g.:
#   LIVEKIT_API_KEY=API$(openssl rand -hex 6)
#   LIVEKIT_API_SECRET=$(openssl rand -hex 32)
# Use the same values in the Next.js app's .env.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
